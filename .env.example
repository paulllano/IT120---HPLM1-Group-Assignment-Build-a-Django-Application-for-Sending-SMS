# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file. It is listed in .gitignore.

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Which SMS service to use:
#   smsgate = SMS Gateway for Android: sends from an Android phone's SIM (free, uses the phone's load)
#   console = test mode: nothing is sent, the message is printed in the terminal
SMS_PROVIDER=smsgate

# SMS Gateway for Android (https://sms-gate.app)
# Open the app on the phone > turn on "Cloud server" > copy the values shown there.
SMSGATE_USERNAME=your-username
SMSGATE_PASSWORD=your-password
# Optional: only needed if more than one phone is connected to the same account.
SMSGATE_DEVICE_ID=
# Optional: which SIM sends on a dual-SIM phone (1 or 2). Blank = the phone's default SIM.
SMSGATE_SIM_NUMBER=
